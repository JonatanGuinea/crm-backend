PORT=8000
DATABASE_URL=postgresql://usuario:password@localhost:5432/crm_db
JWT_SECRET=tu_secret_aqui
FRONTEND_URL=http://localhost:5173        # producción: https://app.danteup.com

# true en local: no corre recordatorios, alertas, informes ni backups (no definir en producción)
DISABLE_CRONS=true

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxxx
SUPABASE_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Email (descomentar y completar cuando se elija el proveedor)
# EMAIL_FROM=Empresa <noreply@tudominio.com>
#
# Resend:
# RESEND_API_KEY=re_xxx
#
# SMTP / Nodemailer:
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=usuario@tudominio.com
# SMTP_PASS=password
# Cloudflare Turnstile ("No soy un robot" en login y registro). Vacío = no se exige.
# En local podés usar la clave de prueba de Cloudflare que siempre aprueba: 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=

# Panel Sistema (/admin)
# Umbral en ms para registrar una consulta de Prisma como lenta en el monitoreo (por defecto 500)
SLOW_QUERY_MS=500
# Backup manual desde el panel: solo se permite con NODE_ENV=production, porque el bucket de backups
# es compartido. Poner true SOLO si este entorno tiene su propio bucket.
# ALLOW_MANUAL_BACKUP=true
# Capacidad de la base en el panel: tope explícito en bytes (ej. cuota del proveedor). Si no se define,
# se mide el disco del servidor (solo cuando la base corre en el mismo host, como en Dokploy).
# DB_CAPACITY_BYTES=8589934592
# Ruta del disco a medir (por defecto /)
# DB_DISK_PATH=/
