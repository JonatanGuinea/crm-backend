

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  avatar        String?
  phone         String?
  isSystemAdmin      Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  emailVerifyToken   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownedOrganizations Organization[]
  memberships        OrganizationMembership[]
  clients            Client[]
  projects           Project[]
  projectMembers     ProjectMember[]
  quotes             Quote[]
  invoices           Invoice[]
  notifications      Notification[]
  attachments        Attachment[]
  expenses           Expense[]
  assignedTasks      Task[]           @relation("TaskAssignee")
  createdTasks       Task[]           @relation("TaskCreator")
  taskHistory        TaskHistory[]
  clientHistory      ClientHistory[]
  projectHistory     ProjectHistory[]
  quoteHistory       QuoteHistory[]
  stockMovements     StockMovement[]
  cashMovements      CashMovement[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(free)
  cuit      String?
  email     String?
  website   String?
  phone     String?
  address   String?
  logo                String?
  city                String?
  province            String?
  postalCode          String?
  signature           String?
  signatureOwnerName  String?
  defaultCurrency      String  @default("USD")
  defaultCashAccountId String?
  ownerId         String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                     @relation(fields: [ownerId], references: [id])
  memberships OrganizationMembership[]
  clients     Client[]
  projects    Project[]
  quotes        Quote[]
  invoices      Invoice[]
  notifications      Notification[]
  attachments        Attachment[]
  installments       Installment[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  tasks              Task[]
  productCategories  ProductCategory[]
  products           Product[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  financialCategories FinancialCategory[]
  cashAccounts        CashAccount[]
  cashMovements       CashMovement[]

  @@index([name])
}

enum Plan {
  free
  pro
  enterprise
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

enum Role {
  owner
  admin
  member
}

enum MembershipStatus {
  active
  invited
  disabled
}

model Client {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  city           String?
  province       String?
  postalCode     String?
  cuit           String?
  website        String?
  notes          String?
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id])
  projects       Project[]
  quotes         Quote[]
  invoices       Invoice[]
  history        ClientHistory[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, name])
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String?
  budget         Float?
  status         ProjectStatus @default(pending)
  startDate      DateTime?
  endDate        DateTime?
  clientId       String
  organizationId String
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id])
  quotes         Quote[]
  invoices       Invoice[]
  tasks          Task[]
  history        ProjectHistory[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  members        ProjectMember[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
}

model ProjectMember {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId, organizationId])
}

enum ProjectStatus {
  pending
  approved
  in_progress
  finished
  cancelled
}

// ─── Billing ──────────────────────────────────────────────────────────────────

enum QuoteStatus {
  draft
  sent
  approved
  signed
  rejected
  expired
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
  partial
}

model Quote {
  id         String      @id @default(cuid())
  number     Int
  title      String
  status     QuoteStatus @default(draft)
  notes        String?
  validUntil   DateTime?
  deliveryDate DateTime?
  subtotal      Float
  discountType  String?
  discountValue Float?
  taxRate       Float    @default(0)
  total         Float
  currency      String   @default("USD")

  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])

  sentByEmail      Boolean   @default(false)
  sentByWhatsapp   Boolean   @default(false)
  sentAt           DateTime?
  reminderSentAt   DateTime?
  rejectionReason  String?

  // Datos temporales de cliente potencial (se eliminan al aprobar)
  potentialClientName    String?
  potentialClientEmail   String?
  potentialClientPhone   String?
  potentialClientCompany String?
  potentialProjectTitle  String?

  // Firma digital del cliente al confirmar
  clientSignature   String?
  clientSignedAt    DateTime?

  items          QuoteItem[]
  invoices       Invoice[]
  installments   Installment[]
  history        QuoteHistory[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  amount      Float
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Invoice {
  id      String        @id @default(cuid())
  number  Int
  title   String
  status  InvoiceStatus @default(draft)
  notes   String?
  dueDate DateTime?
  subtotal Float
  taxRate  Float        @default(0)
  total    Float
  currency String       @default("USD")

  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  quoteId        String?
  quote          Quote?       @relation(fields: [quoteId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])

  items        InvoiceItem[]
  installments Installment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  amount      Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─── Installments ────────────────────────────────────────────────────────────

model Installment {
  id        String   @id @default(cuid())
  number    Int
  amount    Float
  dueDate   DateTime
  status    String   @default("pending")
  paidAt    DateTime?

  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quoteId        String?
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([quoteId])
  @@index([organizationId])
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id             String   @id @default(cuid())
  name           String
  isDefault      Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Expense {
  id             String   @id @default(cuid())
  title          String
  amount         Float
  currency       String   @default("USD")
  date           DateTime
  notes          String?
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, date(sort: Desc)])
  @@index([organizationId, categoryId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  assignedToId   String?
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id])

  history     TaskHistory[]
  stockItems  TaskStockItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, createdAt(sort: Desc)])
}

// ─── Task History ─────────────────────────────────────────────────────────────

model TaskHistory {
  id             String      @id @default(cuid())
  taskId         String
  task           Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  fromStatus     TaskStatus?
  toStatus       TaskStatus
  organizationId String
  createdAt      DateTime    @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([taskId])
}

// ─── Task Stock Items ─────────────────────────────────────────────────────────

model TaskStockItem {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Decimal  @db.Decimal(15, 4)
  organizationId String
  createdAt      DateTime @default(now())

  @@index([taskId])
  @@index([productId])
}

// ─── Quote History ────────────────────────────────────────────────────────────

model QuoteHistory {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  action         String
  detail         String?
  organizationId String
  createdAt      DateTime @default(now())

  @@index([quoteId, createdAt(sort: Desc)])
}

// ─── Project History ──────────────────────────────────────────────────────────

model ProjectHistory {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  action         String
  detail         String?
  organizationId String
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
}

// ─── Client History ───────────────────────────────────────────────────────────

model ClientHistory {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  action         String
  detail         String?
  organizationId String
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt(sort: Desc)])
}

// ─── Attachments ─────────────────────────────────────────────────────────────

enum AttachmentEntity {
  client
  project
  quote
  invoice
}

model Attachment {
  id          String           @id @default(cuid())
  filename    String
  storedName  String
  url         String
  mimetype    String
  size        Int
  entityType  AttachmentEntity
  entityId    String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId])
}

// ─── Stock ───────────────────────────────────────────────────────────────────

enum ProductStatus {
  active
  inactive
  discontinued
}

enum InventoryType {
  sale         // Producto para venta a clientes
  internal     // Insumo / material de uso interno
  raw_material // Materia prima
}

enum MovementType {
  initial               // Carga inicial de stock
  purchase              // Compra a proveedor
  sale                  // Venta a cliente
  adjustment_in         // Ajuste positivo manual
  adjustment_out        // Ajuste negativo manual
  return_in             // Devolución de cliente
  return_out            // Devolución a proveedor
  production_in         // Producto terminado / ensamblado
  production_out        // Consumo en producción
  transfer_in           // Transferencia recibida
  transfer_out          // Transferencia enviada
  correction            // Corrección de error
  internal_consumption  // Consumo interno (insumos / materias primas)
}

enum MovementDirection {
  IN
  OUT
}

model ProductCategory {
  id             String   @id @default(cuid())
  orgId          String
  parentId       String?
  name           String
  description    String?
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryTree")
  products     Product[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, parentId])
}

model Product {
  id         String        @id @default(cuid())
  orgId      String
  categoryId String?
  supplierId String?

  sku         String
  name        String
  description String?
  unit        String        @default("unidad")

  stock    Decimal       @default(0) @db.Decimal(15, 4)
  minStock Decimal       @default(0) @db.Decimal(15, 4)
  maxStock Decimal?      @db.Decimal(15, 4)

  costPrice     Decimal? @db.Decimal(15, 2)
  salePrice     Decimal? @db.Decimal(15, 2)

  inventoryType InventoryType @default(sale)
  status        ProductStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  movements      StockMovement[]
  quoteItems     QuoteItem[]
  taskStockItems TaskStockItem[]

  @@unique([orgId, sku])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, inventoryType])
  @@index([orgId, categoryId])
  @@index([orgId, stock])
}

model StockMovement {
  id        String            @id @default(cuid())
  orgId     String
  productId String

  type      MovementType
  direction MovementDirection

  quantity      Decimal @db.Decimal(15, 4)
  previousStock Decimal @db.Decimal(15, 4)
  currentStock  Decimal @db.Decimal(15, 4)

  unitCost  Decimal? @db.Decimal(15, 2)
  totalCost Decimal? @db.Decimal(15, 2)

  reason    String?
  reference String?

  quoteId   String?
  projectId String?
  clientId  String?

  createdById String
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quote        Quote?       @relation(fields: [quoteId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, productId, createdAt(sort: Desc)])
  @@index([orgId, type])
  @@index([productId, createdAt(sort: Desc)])
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  email          String?
  phone          String?
  address        String?
  website        String?
  notes          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products     Product[]
  cashMovements CashMovement[]

  @@index([orgId])
  @@index([orgId, name])
}

// ─── Finances ────────────────────────────────────────────────────────────────

enum CashAccountType {
  cash
  bank
  virtual
}

enum CashAccountStatus {
  active
  inactive
}

enum CashMovementType {
  income
  expense
  transfer_out
  transfer_in
  adjustment
}

enum CashMovementStatus {
  pending
  confirmed
  annulled
}

enum PaymentMethod {
  cash
  bank_transfer
  check
  credit_card
  debit_card
  mercado_pago
  other
}

enum FinancialCategoryType {
  income
  expense
}

model FinancialCategory {
  id        String               @id @default(cuid())
  orgId     String
  name      String
  type      FinancialCategoryType
  parentId  String?
  color     String?
  isDefault Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       FinancialCategory?  @relation("FinCatTree", fields: [parentId], references: [id])
  children     FinancialCategory[] @relation("FinCatTree")
  movements    CashMovement[]

  @@unique([orgId, name, type])
  @@index([orgId, type])
}

model CashAccount {
  id             String            @id @default(cuid())
  orgId          String
  name           String
  type           CashAccountType   @default(cash)
  currency       String            @default("ARS")
  initialBalance Decimal           @default(0) @db.Decimal(15, 2)
  currentBalance Decimal           @default(0) @db.Decimal(15, 2)
  description    String?
  status         CashAccountStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  movements    CashMovement[] @relation("AccountMovements")
  transfersTo  CashMovement[] @relation("TransferDestination")

  @@index([orgId, status])
}

model CashMovement {
  id      String             @id @default(cuid())
  orgId   String
  accountId String

  type      CashMovementType
  concept   String
  categoryId String?
  amount    Decimal            @db.Decimal(15, 2)
  balanceBefore Decimal        @db.Decimal(15, 2)
  balanceAfter  Decimal        @db.Decimal(15, 2)

  paymentMethod PaymentMethod  @default(cash)
  status        CashMovementStatus @default(pending)

  date        DateTime
  description String?
  reference   String?

  clientId    String?
  projectId   String?
  supplierId  String?
  quoteId     String?

  transferPairId    String?
  toAccountId       String?
  annulledById      String?
  annulmentReason   String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      CashAccount        @relation("AccountMovements", fields: [accountId], references: [id])
  toAccount    CashAccount?       @relation("TransferDestination", fields: [toAccountId], references: [id])
  category     FinancialCategory? @relation(fields: [categoryId], references: [id])
  client       Client?            @relation(fields: [clientId], references: [id])
  project      Project?           @relation(fields: [projectId], references: [id])
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  quote        Quote?             @relation(fields: [quoteId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
  annulledBy   CashMovement?      @relation("AnnulmentPair", fields: [annulledById], references: [id])
  annuls       CashMovement[]     @relation("AnnulmentPair")

  @@index([orgId, date(sort: Desc)])
  @@index([orgId, accountId, date(sort: Desc)])
  @@index([orgId, type, date(sort: Desc)])
  @@index([orgId, categoryId, date(sort: Desc)])
  @@index([orgId, status, date(sort: Desc)])
  @@index([orgId, clientId])
  @@index([orgId, projectId])
  @@index([transferPairId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  invoice_overdue
  invoice_paid
  quote_expiring
  quote_approved
  quote_rejected
  project_deadline
  member_joined
  task_assigned
  stock_out
  stock_low
}

model Notification {
  id      String           @id @default(cuid())
  type     NotificationType
  title    String
  message  String
  metadata String?
  read     Boolean          @default(false)
  refId    String

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([type, userId, organizationId, refId])
  @@index([userId, organizationId, read])
  @@index([userId, organizationId, createdAt(sort: Desc)])
}
